# Trellis workspace journals
.trellis/workspace/*/journal-*.log

# Trellis runtime and developer state
.trellis/.developer
.trellis/.runtime/

# Python cache
__pycache__/
*.py[cod]

# Local logs
*.log

# Session exports (large, regenerable artifacts)
omp-session-*.html

# Local workflow-config backup (never tracked)
workdlowbak/

# Local reproducible native build outputs
patches/.native-artifacts/
