# S0.1 — fixed sandbox env for ACP eval (task 09-06-acp-omp-eval)
export HOME=/tmp/acp-sandbox/home
export XDG_CONFIG_HOME=/tmp/acp-sandbox/home/.config
export XDG_DATA_HOME=/tmp/acp-sandbox/home/.local/share
export XDG_CACHE_HOME=/tmp/acp-sandbox/home/.cache
export XDG_STATE_HOME=/tmp/acp-sandbox/home/.local/state
export ACP_OMP_FOLD_DIR=/tmp/acp-sandbox/folds
export ACP_LOG_FILE=/tmp/acp-sandbox/logs/acp-omp.log
export PI_OPENAI_STATEFUL=0
export ACP_AUTO_UPDATE=0
