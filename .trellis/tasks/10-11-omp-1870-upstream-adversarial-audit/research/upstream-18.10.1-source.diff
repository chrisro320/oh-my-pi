+		text([span(detail)], { wrap: "word", role: "omp.autoresearch.empty.detail" }),
+	];
+	if (archived > 0) {
+		children.push(
+			text([span(`${archived} ${archived === 1 ? "run" : "runs"} archived from earlier segments`)], {
