+/** Measured per-frame price for `modelId` at `frameSize`, or `undefined` when
+ *  the model line is unmeasured (keep the API family's formula). */
+function modelFrameTokenEstimate(modelId: string | undefined, frameSize: number): number | undefined {
+	if (!modelId) return undefined;
+	const steps = MODEL_FRAME_TOKEN_STEPS[modelId];
+	if (!steps) return undefined;
+	let tokens: number | undefined;
+	for (const [edge, price] of steps) {
+		if (frameSize >= edge) tokens = price;
+	}
+	return tokens;
+}
