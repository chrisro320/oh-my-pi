+const cacheTurnSegment: StatusLineSegment = {
+	id: "cache_turn",
+	render(ctx) {
+		// `cache_read` / `cache_hit` are session-cumulative. This is the per-turn
+		// view: cache-read tokens and hit rate of the most recent *settled*
+		// assistant message. The `stopReason` guard is load-bearing — a streaming
+		// message carries partially-filled usage (input lands before cacheRead is
+		// backfilled), which otherwise renders a bogus near-zero hit rate.
+		const messages = ctx.session.messages;
+		let usage: { input: number; cacheRead: number; cacheWrite: number } | undefined;
+		for (let index = messages.length - 1; index >= 0; index--) {
+			const message = messages[index];
+			if (message?.role !== "assistant") continue;
+			if (!message.stopReason || !message.usage || message.stopReason === "aborted" || message.stopReason === "error") continue;
+			usage = message.usage;
+			break;
+		}
+		if (!usage?.cacheRead) return { content: "", visible: false };
+
+		const total = usage.cacheRead + usage.cacheWrite + usage.input;
+		const rate = total > 0 ? (usage.cacheRead / total) * 100 : 0;
+		const content = `trn ${formatNumber(usage.cacheRead)} ${rate.toFixed(1)}%`;
+		return { content: theme.fg("statusLineOutput", content), visible: true };
+	},
+};
