+/**
+ * Records what the summarizer actually sent and what it cost, gated on
+ * `OMP_COMPACTION_TRACE` naming a file.
+ *
+ * This has to live inside compaction, not in an extension. Summarization runs
+ * through `completeSimple`, so the `before_provider_request` hook never fires
+ * for it, and wrapping `globalThis.fetch` does not help either: for
+ * `anthropic` + `anthropic-messages`, `defaultFetchForModel` returns the
+ * imported `coworkFetch`, which sends over `node:https` and bypasses the
+ * global entirely (see pi-ai `stream.ts` and `providers/cowork-fetch.ts`).
+ * Every out-of-band vantage point therefore reports nothing for exactly the
+ * model whose compaction cost matters most.
+ *
+ * Message count is the load-bearing field: the flattened `<conversation>`
+ * fallback always sends exactly ONE message, so it distinguishes the cheap
+ * path from the expensive one without relying on any provider's accounting.
+ */
+function traceCompaction(record: Record<string, unknown>): void {
+	if (process.env.OMP_COMPACTION_TRACE_OFF) return;
+	// On by default: a compaction happens a handful of times per session and
+	// writes two lines, while the question it answers — did the summarizer take
+	// the cache-preserving path — is otherwise unobservable after the fact. An
+	// opt-in flag only guarantees the trace is missing on the run that mattered.
+	const target = process.env.OMP_COMPACTION_TRACE ?? join(homedir(), ".omp", "agent", "compaction-trace.log");
+	try {
+		appendFileSync(target, `${JSON.stringify({ at: new Date().toISOString(), pid: process.pid, ...record })}\n`);
+	} catch {
+		// Diagnostics must never take down a compaction.
+	}
+}
+
+/**
+ * Dump the summary request's real wire payload.
+ *
+ * `completeSimple` bypasses `before_provider_request`, so extensions that
+ * archive outbound payloads never see this request — the one request whose
+ * prefix mismatch (measured `cacheRead: 0`) is still unexplained. `onPayload`
+ * is the only hook that observes it after provider conversion, which is the
+ * layer a comparison against an archived live payload is valid at.
+ *
+ * Latest-only, overwritten each time: one file is enough to diff against the
+ * live turn, and these payloads are megabytes.
+ */
+function traceSummaryWirePayload(payload: unknown, modelId: string): void {
+	if (process.env.OMP_COMPACTION_TRACE_OFF) return;
+	try {
+		const target =
+			process.env.OMP_COMPACTION_PAYLOAD ?? join(homedir(), ".omp", "agent", "compaction-payload-latest.json");
+		writeFileSync(target, JSON.stringify(payload));
+		// Fingerprint the prefix in the trace too, so the shape survives even
+		// after the next compaction overwrites the payload file.
+		const bag = payload as { system?: unknown; messages?: unknown; tools?: unknown };
+		const system = Array.isArray(bag.system) ? bag.system : undefined;
+		const messages = Array.isArray(bag.messages) ? bag.messages : undefined;
+		const tools = Array.isArray(bag.tools) ? bag.tools : undefined;
+		traceCompaction({
+			k: "summarize.wire",
+			model: modelId,
+			file: target,
+			systemParts: system?.length,
+			// Lengths, not text: enough to tell "same prefix" from "different
+			// prefix" without copying the transcript into a log.
+			systemLengths: system?.map(part => {
+				const text = (part as { text?: unknown })?.text;
+				return typeof text === "string" ? text.length : null;
+			}),
+			messages: messages?.length,
+			toolNames: tools?.map(tool => (tool as { name?: unknown })?.name),
+			breakpoints: messages?.flatMap((message, index) => {
+				const content = (message as { content?: unknown }).content;
+				if (!Array.isArray(content)) return [];
+				return content.flatMap(block => {
+					const cc = (block as { cache_control?: { ttl?: string } }).cache_control;
+					return cc ? [`${index}:${cc.ttl ?? "5m"}`] : [];
+				});
+			}),
+		});
+	} catch {
+		// Diagnostics must never take down a compaction.
+	}
+}
