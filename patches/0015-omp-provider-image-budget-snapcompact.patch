+/** Per-request image budget for `provider`, falling back to the wire `api`
+ *  family before the floor. Provider ids multiply faster than wire apis
+ *  (e.g. `google-antigravity` rides the `google-gemini-cli` api), and silently
+ *  dropping to the floor of 5 makes a single attached image evict the oldest
+ *  snapcompact archive frame — rewriting `contents[0]` and voiding the whole
+ *  prompt-cache prefix. */
+export function providerImageBudget(provider: string | undefined, api?: string | undefined): number {
+	const byProvider = provider !== undefined ? PROVIDER_IMAGE_BUDGETS[provider] : undefined;
+	if (byProvider !== undefined) return byProvider;
+	const byApi = api !== undefined ? PROVIDER_IMAGE_BUDGETS[api] : undefined;
+	return byApi ?? DEFAULT_PROVIDER_IMAGE_BUDGET;
 }
 
 /** Archive frame cap for `provider`: image budget, never above {@link MAX_FRAMES_DEFAULT}. */
-export function providerFrameBudget(provider: string | undefined): number {
