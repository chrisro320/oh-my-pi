+/**
+ * Model shown in picker: the newest tail model_change selects what resume
+ * restores when that transition is visible. This rule lives in
+ * `getRestorableSessionModels` / `getLastModelChangeRole` -- the
+ * branch's newest `model_change` decides, and each role keeps its own newest
+ * value. A `default` (or pre-role) transition, and a `fallback` one (retry
+ * swaps recorded by turn-recovery: transient degradations that must never
+ * masquerade as the user's pick), resolve to the default model; any other role
+ * -- `smol`, `slow`, `vision`, `plan`, `commit`, `tiny`, `task`, `advisor`, or
+ * a settings-defined one -- resolves to that role's own model. When the tail
+ * has no model_change, the newest assistant message identifies the model
+ * that last served the session. Prefer it to the initial default in the
+ * prefix: intervening switches can lie outside both scanned windows.
+ * Only with neither tail signal does the initial default win.
+ */
+function deriveLastModel(suffix: string, prefix: string): string | undefined {
