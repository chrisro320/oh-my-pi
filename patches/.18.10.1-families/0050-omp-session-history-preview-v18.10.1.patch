+const ANSI_REGEX = /\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])/g;
+
+function cleanContentText(s: string): string[] {
+	const stripped = s.replace(ANSI_REGEX, "");
+	const noControls = stripped.replace(/\r/g, "").replace(/[\x00-\x08\x0B-\x1F\x7F]/g, "");
+	return replaceTabs(noControls).split("\n").map(l => l.trimEnd());
+}
+
+function extractConversationText(m: AgentMessage): string[] {
+	if (m.role !== "user" && m.role !== "assistant") return [];
+	const raw = "content" in m ? m.content : undefined;
+	if (typeof raw === "string") {
+		return cleanContentText(raw);
+	}
+	if (Array.isArray(raw)) {
+		const hasToolCall = raw.some(b => b && typeof b === "object" && "type" in b && b.type === "toolCall");
+		const lines: string[] = [];
+		for (const block of raw) {
+			if (
+				block &&
+				typeof block === "object" &&
+				"type" in block &&
+				block.type === "text" &&
+				typeof block.text === "string"
+			) {
+				const blockLines = cleanContentText(block.text);
+				if (hasToolCall) {
+					const nonEmpty = blockLines.filter(l => l.trim().length > 0);
+					if (nonEmpty.length === 0 || (nonEmpty.length === 1 && /^```\w*$/.test(nonEmpty[0]!.trim()))) {
+						continue;
+					}
+				}
+				lines.push(...blockLines);
+			}
+		}
+		return lines;
+	}
+	return [];
+}
