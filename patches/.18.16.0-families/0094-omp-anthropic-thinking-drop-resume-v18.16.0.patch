+/**
+ * Validate a persisted replay-invalidation record before it can drop anything.
+ * A session file can carry anything in this field (older writers, hand edits,
+ * partial JSON), so a malformed record is ignored whole rather than trusted
+ * partially — it must never cause a blanket drop or throw on the request path.
+ */
+function readDroppedThinkingReplay(value: unknown): ProviderDroppedThinkingReplay | undefined {
+	if (!isRecord(value)) return undefined;
+	const { endpoint, model, keys, source } = value;
+	if (source !== undefined && source !== "client-prefix-binding") return undefined;
+	if (typeof endpoint !== "string" || typeof model !== "string" || !Array.isArray(keys)) return undefined;
+	if (!keys.every(key => typeof key === "string")) return undefined;
+	return { endpoint, model, keys, source };
+}
+
