+	const pending: unknown[] = [usage];
+	while (pending.length > 0) {
+		const value = pending.pop();
+		if (typeof value === "number") {
+			if (value !== 0) return false;
+			continue;
+		}
+		if (value === null || value === undefined) continue;
+		if (typeof value === "object") {
