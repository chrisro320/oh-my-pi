+/**
+ * Measured per-frame billing for model lines their wire `api` cannot express.
+ *
+ * `commandcode-custom` is ONE api shared by every model the Command Code
+ * gateway serves, so {@link billingFamily} prices all of them with the
+ * Anthropic pixel-area formula. That is right for the Claude routes it carries
+ * (Opus reads 1932px at 5,000) and a 3.3x-5.0x overcharge on the DeepSeek
+ * vision routes, which bill ~1,000/image above 1280px instead. The formula's
+ * 4784-patch cap makes the error grow with frame size: a 1568px frame is priced
+ * 3,293 against a measured 995 (+2,298), and a 2576px frame 5,024 against 1,011
+ * (+4,013). The overcharge lands on the reduction guard: the archived frames are
+ * priced thousands of tokens too high each, so a compaction that genuinely
+ * shrinks the request reads as "would not reduce context" and may be rejected
+ * back to an LLM summary.
+ *
+ * Keyed by EXACT model id, not by a provider prefix, because this vendor's
+ * per-image price is not uniform across a model line. The same 2026-09-10
+ * probe that measured 995 on the three ids below measured **6** on
+ * `deepseek/deepseek-v4-pro` and **0** on `deepseek/deepseek-v4-flash-fast`
+ * (both text-only in the catalog, so neither is reachable through
+ * snapcompact today -- but a `^deepseek/` prefix would silently price them at
+ * 995 if that ever changed). Ids absent here are unmeasured and keep the API
+ * family's formula: an invented number is worse than the formula it replaces.
+ *
+ * Entries are `[frameEdge, tokensPerFrame]` in ascending edge order; the last
+ * edge at or below the resolved frame size wins. A frame below the first
+ * measured edge counts as unmeasured. Every step is a measurement, and each
+ * value covers the sizes above it up to the next edge, and the final step also
+ * covers everything above it. The table is exact at the two sizes shipped
+ * variants reach (1568 and 2576, both measured) and conservative at the
+ * measured checkpoints inside the steps (2048 would bill 995 against a measured
+ * 993; 3584 would bill 1011 against 989). It is NOT an upper bound for
+ * unmeasured sizes above 2576 -- only measured points carry a guarantee.
+ */
+const DEEPSEEK_VISION_FRAME_TOKENS: ReadonlyArray<readonly [number, number]> = [
+	[256, 198],
+	[512, 198],
+	[768, 363],
+	[1024, 653],
+	[1280, 995],
+	[2576, 1011],
+];
+
+const MODEL_FRAME_TOKEN_STEPS: Readonly<Record<string, ReadonlyArray<readonly [number, number]>>> = {
+	"deepseek/deepseek-v4-flash-vision-exp": DEEPSEEK_VISION_FRAME_TOKENS,
+	"deepseek/deepseek-v4.1-flash": DEEPSEEK_VISION_FRAME_TOKENS,
+	"deepseek/deepseek-v4-flash": DEEPSEEK_VISION_FRAME_TOKENS,
+};
+
+/** Measured per-frame price for `modelId` at `frameSize`, or `undefined` when
+ *  the model line is unmeasured (keep the API family's formula). */
+function modelFrameTokenEstimate(modelId: string | undefined, frameSize: number): number | undefined {
+	if (!modelId) return undefined;
+	const steps = MODEL_FRAME_TOKEN_STEPS[modelId];
+	if (!steps) return undefined;
+	let tokens: number | undefined;
+	for (const [edge, price] of steps) {
+		if (frameSize >= edge) tokens = price;
+	}
+	return tokens;
+}
