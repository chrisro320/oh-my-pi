+ * Message count is the load-bearing field: the flattened `<conversation>`
+ * fallback always sends exactly ONE message, so it distinguishes the cheap
+ * path from the expensive one without relying on any provider's accounting.
+ */
+function traceCompaction(record: Record<string, unknown>): void {
+	if (process.env.OMP_COMPACTION_TRACE_OFF) return;
+	// On by default: a compaction happens a handful of times per session and
+	// writes two lines, while the question it answers -- did the summarizer take
+	// the cache-preserving path -- is otherwise unobservable after the fact. An
+	// opt-in flag only guarantees the trace is missing on the run that mattered.
+	const target = process.env.OMP_COMPACTION_TRACE ?? join(homedir(), ".omp", "agent", "compaction-trace.log");
+	try {
+		appendFileSync(target, `${JSON.stringify({ at: new Date().toISOString(), pid: process.pid, ...record })}\n`);
+	} catch {
+		// Diagnostics must never take down a compaction.
+	}
