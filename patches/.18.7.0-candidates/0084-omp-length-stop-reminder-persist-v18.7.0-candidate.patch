+	/**
+	 * Append the length-stop retry reminder to the live context AND the session
+	 * file, as the other recovery reminders do (see turn-recovery.ts). Kept in
+	 * memory only, a rebuild from disk (resume, in-process context rebuild) drops
+	 * it, so the next request forks the provider's cached prefix at the reminder's
+	 * index and re-writes the whole tail. The caller appends it after dropping the
+	 * persisted length turn, so the file order stays identical to the live order.
+	 */
+	#appendLengthStopReminder(text: string): void {
+		const reminder: Message = {
+			role: "developer",
+			content: [{ type: "text", text }],
+			attribution: "agent",
+			timestamp: Date.now(),
+		};
+		this.#host.agent.appendMessage(reminder);
+		this.#host.sessionManager.appendMessage(reminder);
