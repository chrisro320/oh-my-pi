+const ROLLOVER_REPLY_TEXT_LIMIT = 2_000;
+const ROLLOVER_REPLY_TRUNCATED = "[First reply truncated; the full text is in history://current/full]";
+// Static notice only: interpolated text would be post-formatted (trailing
+// whitespace, blank lines, tables), so the request and reply are added verbatim.
+const ROLLOVER_ANSWERED_NOTICE = prompt.render(rolloverAnsweredRequestTemplate);
+// The reply is assistant-authored data: every `<` is neutralized so no quoted
+// markup (harness tags, comments, CDATA) can read as authoritative or swallow
+// the closing `</first-reply>`.
+const ESCAPED_MARKUP_OPENER = "&lt;";
+
+// One replay object per request while its content is unchanged: the date/cwd
+// reminder treats an unseen user turn as new, so a rebuild must return the
+// same object. Shake rewrites the request or its reply in place (custom-message
+// entries without any invalidation), so the cache keeps its own text snapshots
+// and compares the content it would send instead of trusting invalidation hooks.
+const answeredRolloverRequests = new WeakMap<object, UserMessage>();
+
+function rolloverReplyBlock(reply: AssistantMessage): string {
+	const parts: string[] = [];
+	for (const part of reply.content) if (part.type === "text" && part.text) parts.push(part.text);
+	let text = parts.join("\n").trim().replaceAll("<", ESCAPED_MARKUP_OPENER);
+	let truncated = "";
+	// Bound the escaped excerpt the model actually reads, never splitting an escape.
+	if (text.length > ROLLOVER_REPLY_TEXT_LIMIT) {
+		let end = ROLLOVER_REPLY_TEXT_LIMIT;
+		const escape = text.lastIndexOf(ESCAPED_MARKUP_OPENER, end - 1);
+		if (escape >= 0 && escape + ESCAPED_MARKUP_OPENER.length > end) end = escape;
+		const last = text.charCodeAt(end - 1);
+		if (last >= 0xd800 && last <= 0xdbff) end--;
+		text = text.slice(0, end);
+		truncated = `\n${ROLLOVER_REPLY_TRUNCATED}`;
+	}
+	return `<first-reply>\n${text}${truncated}\n</first-reply>`;
+}
+
+/** Image blocks compare by every provider-visible field, payload last. */
+function sameImage(a: ImageContent, b: ImageContent): boolean {
+	return a.data === b.data && JSON.stringify({ ...a, data: "" }) === JSON.stringify({ ...b, data: "" });
+}
+
+function sameReplay(cached: UserMessage, content: UserMessage["content"], attribution: unknown, timestamp: number) {
+	if (cached.timestamp !== timestamp || cached.attribution !== attribution) return false;
+	const previous = cached.content;
+	if (typeof previous === "string" || typeof content === "string" || previous.length !== content.length) return false;
+	for (let i = 0; i < content.length; i++) {
+		const a = previous[i];
+		const b = content[i];
+		if (a.type === "text" && b.type === "text") {
+			if (a.text !== b.text) return false;
+		} else if (a.type === "image" && b.type === "image") {
+			if (!sameImage(a, b)) return false;
+		} else {
+			return false;
+		}
+	}
+	return true;
+}
+
+/**
+ * A rollover request that already received a terminal text answer before the
+ * boundary is replayed as a plain user turn carrying that first answer, never
+ * as a steering interjection: the next window must verify before redoing it.
+ * An answer is not completion, so the request blocks are kept verbatim and in
+ * order, after the quoted reply: serializers that hoist text ahead of images
+ * then still keep each image behind its own request text. Unanswered requests
+ * return undefined and keep the original replay.
+ * Content derives from the journal alone, so resume and later rollovers resend
+ * the same bytes.
+ */
+function answeredRolloverRequest(path: SessionEntry[], requestIdx: number, endIdx: number): UserMessage | undefined {
+	let reply: AssistantMessage | undefined;
+	for (let i = requestIdx + 1; i < endIdx && reply === undefined; i++) {
+		const entry = path[i];
+		if (entry.type === "message" && isTerminalTextAssistantAnswer(entry.message)) reply = entry.message;
+	}
+	if (reply === undefined) return undefined;
+	const entry = path[requestIdx];
+	const request =
+		entry.type === "message" ? entry.message : entry.type === "custom_message" ? customMessageEntryMessage(entry) : undefined;
+	if (request === undefined || !("content" in request)) return undefined;
+	const content: UserMessage["content"] = [
+		{ type: "text", text: ROLLOVER_ANSWERED_NOTICE },
+		{ type: "text", text: rolloverReplyBlock(reply) },
+	];
+	if (typeof request.content !== "string") {
+		// Blocks are snapshotted (an image's file reference too): shake and other
+		// owners rewrite the journal's blocks in place.
+		for (const part of request.content) {
+			if (part.type === "text") content.push({ type: "text", text: part.text });
+			else content.push(part.providerFile ? { ...part, providerFile: { ...part.providerFile } } : { ...part });
+		}
+	} else if (request.content.length > 0) {
+		content.push({ type: "text", text: request.content });
+	}
+	// Parent assignments are agent work; a user-role replay without attribution
+	// would otherwise default to user attribution at the provider boundary.
+	const declared = "attribution" in request ? request.attribution : undefined;
+	const attribution = declared ?? (request.role === "custom" ? "agent" : undefined);
+	const key: object = entry.type === "message" ? entry.message : entry;
+	const cached = answeredRolloverRequests.get(key);
+	if (cached && sameReplay(cached, content, attribution, request.timestamp)) return cached;
+	const message: UserMessage = { role: "user", content, timestamp: request.timestamp };
+	if (attribution !== undefined) message.attribution = attribution;
+	answeredRolloverRequests.set(key, message);
+	return message;
+}
