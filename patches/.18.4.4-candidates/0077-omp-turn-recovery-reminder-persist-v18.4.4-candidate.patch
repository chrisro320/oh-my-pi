 	/**
+	 * Append a retry reminder to the live context AND the session file, as the
+	 * plan-mode reminder does. Kept in memory only, a rebuild from disk (resume,
+	 * in-process context rebuild) drops it, so the next request forks the
+	 * provider's cached prefix at the reminder's index and re-writes the rest.
+	 * The 18.4.1 committed-text stall continuation ({@link
+	 * handleCommittedTextStreamStall}) appends its reminder the same way so the
+	 * resumed request keeps the partial turn and the reminder that identifies it.
+	 */
+	#appendRetryReminder(text: string): void {
+		const reminder: Message = {
+			role: "developer",
+			content: [{ type: "text", text }],
+			attribution: "agent",
+			timestamp: Date.now(),
+		};
+		this.#host.agent.appendMessage(reminder);
+		this.#host.sessionManager.appendMessage(reminder);
+	}
+
