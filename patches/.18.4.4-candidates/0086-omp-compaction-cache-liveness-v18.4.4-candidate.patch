+function countExcerptMatches(chain: Message[], excerpt: string): number {
+	let matches = 0;
+	for (const message of chain) {
+		const candidate = messageAnchorExcerpt(message);
+		if (candidate !== undefined && candidate.startsWith(excerpt)) matches++;
+	}
+	return matches;
+}
