+/** Room left for the summarize instruction the request appends. */
+const SUMMARY_INSTRUCTION_TOKEN_ALLOWANCE = 1024;
+/** Shortest trusted excerpt quoted to the model, and the longest worth quoting. */
+const ANCHOR_MIN_CHARS = 24;
+const ANCHOR_MAX_CHARS = 240;
+const ANCHOR_STEP_CHARS = 8;
