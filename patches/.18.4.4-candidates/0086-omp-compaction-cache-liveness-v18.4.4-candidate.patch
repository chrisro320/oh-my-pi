+function providerReadyFitsWindow(context: Context, model: Model, outputAllowance: number): boolean {
+	const window = model.contextWindow && model.contextWindow > 0 ? model.contextWindow : undefined;
+	if (window === undefined) return true;
+	const system = Array.isArray(context.systemPrompt) ? context.systemPrompt.join("\n\n") : "";
