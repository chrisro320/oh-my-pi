+ * A duplicated head favours its last occurrence, because a retained tail is the
+ * chain's suffix, so the later match is the one that can be the tail.
+ */
+function locateRetainedTailAnchor(chain: Message[] | undefined, tailHead: unknown): RetainedTailAnchor | undefined {
+	if (chain === undefined || chain.length === 0) return undefined;
+	const full = messageAnchorExcerpt(tailHead as { role?: string; content?: unknown });
+	if (full === undefined) return undefined;
+	const candidates: number[] = [];
+	for (let index = 0; index < chain.length; index++) {
+		if (messageAnchorExcerpt(chain[index]!) === full) candidates.push(index);
+	}
