+function locateTurnPrefixRange(chain: Message[] | undefined, turnPrefixMessages: AgentMessage[]): TurnPrefixRangeAnchor | undefined {
+	if (chain === undefined || turnPrefixMessages.length === 0) return undefined;
+	const start = locateRetainedTailAnchor(chain, turnPrefixMessages[0]);
