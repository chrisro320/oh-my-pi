+ * that turns `Message[]` into wire messages: the role plus the opening of its
+ * first text or tool payload. `undefined` for a message with nothing printable
+ * (an image-only turn), which makes the boundary unattestable rather than wrong.
+ *
+ * Accepts the raw session form and the provider-ready form alike, because the
+ * cutoff is derived from the session's own retained tail and located inside the
+ * provider-ready chain.
+ */
+function messageAnchorExcerpt(message: { role?: string; content?: unknown }): string | undefined {
+	const role = typeof message.role === "string" ? message.role : "message";
+	const blocks = Array.isArray(message.content) ? message.content : [];
+	for (const candidate of blocks) {
+		const block = candidate as { type?: string; text?: string; name?: string; arguments?: unknown; toolName?: string };
+		if (block.type === "text" && typeof block.text === "string" && block.text.trim().length > 0) {
+			return `${role}: ${block.text.trim()}`;
+		}
+		if (block.type === "toolCall") {
+			return `${role}: toolCall ${block.name ?? ""} ${JSON.stringify(block.arguments ?? {})}`;
+		}
+		if (block.type === "toolResult") {
+			const text = blocks.find(entry => (entry as { type?: string }).type === "text") as { text?: string } | undefined;
+			return `${role}: toolResult ${block.toolName ?? ""} ${(text?.text ?? "").trim()}`;
+		}
+	}
+	return undefined;
+}
