 		}
+		// Command Code serves V4.1 Flash with image input and accepts strict tool
+		// schemas; the live /v1/models rows carry neither fact, so the built-in
+		// record and the pi-commandcode-provider record disagreed and every resume
+		// reshaped the request head (system framing, tool schemas, HISTORY modality).
+		input-modalities "text" "image"
+		supports-strict-mode #true
+		// The deepseek class strips images lineage-wide (exempting only vision/ocr
+		// ids); this deployment accepts image_url - verified on the live route.
+		strip-image-input #false
+		// The plugin record flattens the ordered system prompts into one block;
+		// matching it here is what keeps the cached prefix alive across a resume
+		// no matter which registrant wins the model record.
+		supports-multiple-system-messages #false
 	}
 	models "moonshotai/Kimi-K3" {
 		cost-patch {
