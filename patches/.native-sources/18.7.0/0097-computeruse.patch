+		let Some(state) = self.property(window, state_atom, AtomEnum::ATOM, 64) else {
+			return false;
+		};
+		let Ok(hidden) = self.intern("_NET_WM_STATE_HIDDEN") else {
+			return false;
+		};
+		state
+			.value32()
+			.is_some_and(|mut states| states.any(|atom| atom == hidden))
+	}
