+	/// Whether a compositing manager is available to provide backing pixmaps:
+	/// the extension must be present at a version that has `NameWindowPixmap`
+	/// and the EWMH compositor selection must have an owner.
+	fn require_compositor(&self) -> CoreResult<()> {
+		let extension = self
+			.conn
+			.query_extension(b"Composite")
+			.map_err(request_failed)?
+			.reply()
+			.map_err(request_failed)?;
+		if !extension.present {
+			return Err(DesktopError::capture_failed(
+				"the X11 Composite extension is unavailable; capturing a window without a compositor \
+				 would show whatever covers it, so no view is returned",
+			));
+		}
+		let version = self
+			.conn
+			.composite_query_version(0, 4)
+			.map_err(request_failed)?
+			.reply()
+			.map_err(request_failed)?;
+		if version.major_version == 0 && version.minor_version < 2 {
+			return Err(DesktopError::capture_failed(format!(
+				"the X11 Composite extension is version {}.{}; NameWindowPixmap requires 0.2 or newer",
+				version.major_version, version.minor_version
+			)));
+		}
+		let selection = self.intern(&format!("_NET_WM_CM_S{}", self.screen))?;
+		let owner = self
+			.conn
+			.get_selection_owner(selection)
+			.map_err(request_failed)?
+			.reply()
+			.map_err(request_failed)?
+			.owner;
