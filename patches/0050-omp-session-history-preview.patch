+class SessionPreviewView implements Component {
+	readonly #session: SessionInfo;
+	readonly #onClose: () => void;
+	readonly #onSelect: () => void;
+	readonly #onExit: () => void;
+	readonly #getTerminalRows: () => number;
+	readonly #scrollView: ScrollView;
+	onRequestRender?: () => void;
+	#lines: string[] = [];
+	#generation = 0;
+	#disposed = false;
+	#lastRenderWidth = 80;
+	#lastHeaderRows = 3;
+	#lastScrollViewHeight = 10;
+	#isDraggingScrollbar = false;
+
+	constructor(
+		session: SessionInfo,
+		onClose: () => void,
+		onSelect: () => void,
+		onExit: () => void,
+		getTerminalRows: () => number,
+	) {
+		this.#session = session;
+		this.#onClose = onClose;
+		this.#onSelect = onSelect;
+		this.#onExit = onExit;
+		this.#getTerminalRows = getTerminalRows;
+		this.#lines = [theme.fg("muted", "Loading session history…")];
+		this.#scrollView = new ScrollView(this.#lines, {
+			height: 0,
+			scrollbar: "auto",
+			theme: { track: t => theme.fg("dim", t), thumb: t => theme.fg("accent", t) },
+		});
+		void this.#loadHistory();
+	}
+
+	async #loadHistory(): Promise<void> {
+		const gen = ++this.#generation;
+		try {
+			const messages = await loadSessionMessagesReadOnly(this.#session.path);
+			if (this.#disposed || gen !== this.#generation) return;
+			this.#formatMessages(messages);
+		} catch (err) {
+			if (this.#disposed || gen !== this.#generation) return;
+			this.#lines = [
+				theme.fg("error", `Failed to load preview: ${err instanceof Error ? err.message : String(err)}`),
+			];
+			this.#scrollView.setLines(this.#lines);
+			this.onRequestRender?.();
+		}
+	}
+
+	#formatMessages(messages: AgentMessage[]): void {
+		const lines: string[] = [];
+		const turns: Array<{ role: "user" | "assistant"; textLines: string[] }> = [];
+		for (const m of messages) {
+			if (m.role === "user" || m.role === "assistant") {
+				const textLines = extractConversationText(m);
+				if (textLines.some(l => l.trim().length > 0)) {
+					turns.push({ role: m.role, textLines });
+				}
+			}
+		}
+
+		if (turns.length === 0) {
+			lines.push(theme.fg("muted", "(No conversation messages found in session)"));
+		} else if (turns.length <= 15) {
+			for (const turn of turns) {
+				this.#appendTurnBlock(lines, turn);
+			}
+		} else {
+			for (let i = 0; i < 2; i++) {
+				this.#appendTurnBlock(lines, turns[i]!);
+			}
+			lines.push("");
+			lines.push(theme.fg("dim", `--- … (${turns.length - 12} conversation turns omitted) … ---`));
+			lines.push("");
+			for (let i = turns.length - 10; i < turns.length; i++) {
+				this.#appendTurnBlock(lines, turns[i]!);
+			}
+		}
+		this.#lines = lines;
+		this.#scrollView.setLines(this.#lines);
+		this.onRequestRender?.();
+	}
+
+	#appendTurnBlock(lines: string[], turn: { role: "user" | "assistant"; textLines: string[] }): void {
+		const roleLabel =
+			turn.role === "user" ? theme.fg("accent", theme.bold("User")) : theme.fg("success", theme.bold("Assistant"));
+		lines.push(`[${roleLabel}]`);
+		const maxLines = 20;
+		for (let i = 0; i < Math.min(turn.textLines.length, maxLines); i++) {
+			lines.push(`  ${turn.textLines[i]}`);
+		}
+		if (turn.textLines.length > maxLines) {
+			lines.push(`  ${theme.fg("dim", `… (${turn.textLines.length - maxLines} more lines)`)}`);
+		}
+		lines.push("");
+	}
+
+	dispose(): void {
+		this.#disposed = true;
+		this.#generation++;
+	}
+
+	invalidate(): void {}
+
+	handleInput(keyData: string): void {
+		if (matchesKey(keyData, "ctrl+c")) {
+			this.#onExit();
+			return;
+		}
+		if (matchesKey(keyData, "enter") || matchesKey(keyData, "return") || keyData === "\n") {
+			this.#onSelect();
+			return;
+		}
+		if (matchesKey(keyData, "escape") || matchesKey(keyData, "space") || keyData === " ") {
+			this.#onClose();
+			return;
+		}
+		this.#scrollView.handleScrollKey(keyData);
+		this.onRequestRender?.();
+	}
+
+
+	handleWheel(delta: -1 | 1): void {
+		this.#scrollView.scroll(delta * 2);
+		this.onRequestRender?.();
+	}
+
+	handleMouse(data: string, listLineOffset: number): void {
+		routeSgrMouseInput(data, event => {
+			if (event.wheel !== null) {
+				this.handleWheel(event.wheel);
+				return true;
+			}
+
+			const scrollStartRow = listLineOffset + this.#lastHeaderRows;
+			const scrollEndRow = scrollStartRow + this.#lastScrollViewHeight;
+			const isNearRightEdge = event.col >= Math.max(0, this.#lastRenderWidth - 4);
+
+			if (event.leftClick) {
+				if (isNearRightEdge && event.row >= scrollStartRow && event.row < scrollEndRow) {
+					this.#isDraggingScrollbar = true;
+					this.#scrollToRow(event.row - scrollStartRow);
+					return true;
+				}
+			} else if (event.release) {
+				this.#isDraggingScrollbar = false;
+			} else if (event.motion && this.#isDraggingScrollbar) {
+				this.#scrollToRow(event.row - scrollStartRow);
+				return true;
+			}
+			return true;
+		});
+	}
+
+	#scrollToRow(localRow: number): void {
+		if (this.#lastScrollViewHeight <= 1) return;
+		const ratio = Math.max(0, Math.min(1, localRow / (this.#lastScrollViewHeight - 1)));
+		const targetOffset = Math.round(ratio * this.#scrollView.getMaxScrollOffset());
+		this.#scrollView.setScrollOffset(targetOffset);
+		this.onRequestRender?.();
+	}
+	render(width: number): readonly string[] {
+		this.#lastRenderWidth = width;
+		const lines: string[] = [];
+		const title = this.#session.title || "(Untitled Session)";
+		lines.push(theme.bold(theme.fg("accent", truncateToWidth(title, width))));
+		const status = formatSessionStatus(this.#session.status);
+		const statusStr = status ? ` · ${status}` : "";
+		const meta = `${this.#session.id.slice(0, 8)} · ${shortenPath(this.#session.cwd || "")} · ${formatBytes(this.#session.size)}${statusStr}`;
+		lines.push(theme.fg("dim", truncateToWidth(meta, width)));
+		lines.push(theme.fg("dim", "─".repeat(width)));
+		this.#lastHeaderRows = lines.length;
+
+		const availableHeight = Math.max(4, this.#getTerminalRows() - 9);
+		this.#lastScrollViewHeight = availableHeight;
+		this.#scrollView.setHeight(availableHeight);
+		lines.push(...this.#scrollView.render(width));
+		return lines;
+	}
+}
+
