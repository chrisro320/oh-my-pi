+/**
+ * Model shown in picker: the newest tail model_change selects what resume
+ * restores when that transition is visible. This rule lives in
+ * `getRestorableSessionModels` / `getLastModelChangeRole` -- the
+ * branch's newest `model_change` decides, and each role keeps its own newest
+ * value. A `default` (or pre-role) transition, and a `fallback` one (retry
+ * swaps recorded by turn-recovery: transient degradations that must never
+ * masquerade as the user's pick), resolve to the default model; any other role
+ * -- `smol`, `slow`, `vision`, `plan`, `commit`, `tiny`, `task`, `advisor`, or
+ * a settings-defined one -- resolves to that role's own model. When the tail
+ * has no model_change, the newest assistant message identifies the model
+ * that last served the session. Prefer it to the initial default in the
+ * prefix: intervening switches can lie outside both scanned windows.
+ * Only with neither tail signal does the initial default win.
+ */
+function deriveLastModel(suffix: string, prefix: string): string | undefined {
+	const readEntry = (line: string): TailModelEntry | undefined => {
+		if (line.charCodeAt(0) !== 123) return undefined;
+		try {
+			return JSON.parse(line) as TailModelEntry;
+		} catch {
+			return undefined;
+		}
+	};
+	const lines = suffix.split("\n");
+	// Newest role first (walking backwards), then that role's newest model.
+	// Without a tail transition, prefer the last-served model over the prefix
+	// default, which can predate switches in the unscanned middle.
+	const roleModels = new Map<string, string>();
+	let newestRole: string | undefined;
+	let lastServed: string | undefined;
+	for (let i = lines.length - 1; i >= 0; i--) {
+		const entry = readEntry(lines[i]!);
+		if (!entry) continue;
+		if (entry.type === "model_change" && typeof entry.model === "string" && entry.model) {
+			const role = entry.role ?? "default";
+			newestRole ??= role;
+			if (!roleModels.has(role)) roleModels.set(role, entry.model);
+			const resolved = newestRole === "default" || newestRole === "fallback" ? "default" : newestRole;
+			if (roleModels.has(resolved)) break;
+			continue;
+		}
+		if (
+			lastServed === undefined &&
+			entry.type === "message" &&
+			entry.message?.role === "assistant" &&
+			typeof entry.message.model === "string"
+		) {
+			lastServed = entry.message.provider ? `${entry.message.provider}/${entry.message.model}` : entry.message.model;
+		}
+	}
+	const resolvedRole = !newestRole || newestRole === "default" || newestRole === "fallback" ? "default" : newestRole;
+	const fromTail = roleModels.get(resolvedRole) ?? (!newestRole ? lastServed : undefined);
+	if (fromTail) return fromTail;
+	for (const line of prefix.split("\n")) {
+		const entry = readEntry(line);
+		if (entry?.type === "model_change" && typeof entry.model === "string" && (entry.role ?? "default") === "default") {
+			return entry.model;
+		}
+	}
+	return undefined;
+}
