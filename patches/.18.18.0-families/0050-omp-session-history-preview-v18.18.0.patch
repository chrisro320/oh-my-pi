+/**
+ * Compact selector form of a model for the metadata line: keep the id part,
+ * trim to the last two "/"-separated segments so vendor-prefixed ids like
+ * "commandcode/deepseek/deepseek-v4.1-flash" stay recognizable, and drop
+ * an ":tag" suffix ("ollama-cloud/glm-5.3-flash:max" -> "glm-5.3-flash").
+ */
+function shortenModelName(selector: string): string {
+	const withoutTag = selector.split(":", 1)[0] ?? selector;
+	const segments = withoutTag.split("/").filter(s => s.length > 0);
+	if (segments.length === 0) return selector;
+	return segments.slice(-2).join("/");
+}
