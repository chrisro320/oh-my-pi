+/**
+ * True only when a side request is guaranteed to use the active Agent's exact
+ * runtime model object and wire model id. The reference check is load-bearing:
+ * provider overlays and compat flags can differ while catalog ids stay equal.
+ */
+export function sharesActivePromptCacheIdentity(candidate: Model | undefined, activeModel: Model | undefined): boolean {
+	return (
+		candidate !== undefined &&
+		candidate === activeModel &&
+		candidate.provider === activeModel.provider &&
+		candidate.api === activeModel.api &&
+		candidate.id === activeModel.id &&
+		(candidate.requestModelId ?? candidate.id) === (activeModel.requestModelId ?? activeModel.id)
+	);
