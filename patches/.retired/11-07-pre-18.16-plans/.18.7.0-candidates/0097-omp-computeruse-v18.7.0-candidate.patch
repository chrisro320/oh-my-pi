+/**
+ * Concrete reason a native desktop operation was cancelled. Every host stop is
+ * labelled so a `Cancelled` error names its cause instead of a generic message.
+ * The labels are the stable wire contract shared with the native addon.
+ */
+export type DesktopCancelReason =
+	| "escape"
+	| "keymap-changed"
+	| "monitor-failed"
+	| "native-timeout"
+	| "tool-timeout"
+	| "host-revocation"
+	| "explicit-release"
+	| "session-close"
+	| "helper-failure"
+	| "helper-retire";
+
 /** Clone-safe error metadata returned across the worker boundary. */
 export interface RunErrorPayload {
 	name: string;
