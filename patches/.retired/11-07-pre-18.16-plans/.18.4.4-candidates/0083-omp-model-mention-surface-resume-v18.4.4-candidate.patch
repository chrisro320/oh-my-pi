 const SESSION_AGENT_NOTICE_MESSAGE_TYPE = "session-agent-notice";
 
 /**
+ * Journal entry holding the model-agent list a base rebuild last published (see
+ * {@link PromptSurface.sessionAgents}). It is never converted into a provider message: it
+ * exists so a fresh process seeds the same task description the live session ended with,
+ * instead of rebuilding that description from an empty surface and forking the cached
+ * tools prefix away from what the provider already holds.
+ */
+const ADVERTISED_SESSION_AGENTS_ENTRY_TYPE = "advertised_session_agents";
+
+/** Rendered fields of one advertised model agent, persisted for a later resume. */
+interface PersistedSessionAgent {
+	name: string;
+	description: string;
+	tools?: string[];
+	blocking?: boolean;
+	model?: string[];
+}
+
+/** Stable identity of a persisted surface, used to skip redundant journal writes. */
+function advertisedSessionAgentSignature(agents: readonly PersistedSessionAgent[]): string {
+	return JSON.stringify(
+		agents.map(agent => [
+			agent.name,
+			agent.description,
+			agent.tools ?? null,
+			agent.blocking ?? null,
+			agent.model ?? null,
+		]),
+	);
+}
+
+/**
+ * Model agents the branch last published; the newest entry wins. Malformed payloads are
+ * skipped rather than trusted, so a damaged entry degrades to the live surface.
+ */
+function readAdvertisedSessionAgents(entries: readonly SessionEntry[]): PersistedSessionAgent[] {
+	let latest: PersistedSessionAgent[] = [];
+	for (const entry of entries) {
+		if (entry.type !== "custom" || entry.customType !== ADVERTISED_SESSION_AGENTS_ENTRY_TYPE || !isRecord(entry.data)) {
+			continue;
+		}
+		const agents = entry.data.agents;
+		if (!Array.isArray(agents)) continue;
+		const parsed: PersistedSessionAgent[] = [];
+		for (const agent of agents) {
+			if (!isRecord(agent) || typeof agent.name !== "string" || typeof agent.description !== "string") continue;
+			parsed.push({
+				name: agent.name,
+				description: agent.description,
+				tools: Array.isArray(agent.tools) ? agent.tools.filter((tool): tool is string => typeof tool === "string") : undefined,
+				blocking: agent.blocking === true ? true : undefined,
+				model: Array.isArray(agent.model) ? agent.model.filter((name): name is string => typeof name === "string") : undefined,
+			});
+		}
+		latest = parsed;
+	}
+	return latest;
+}
