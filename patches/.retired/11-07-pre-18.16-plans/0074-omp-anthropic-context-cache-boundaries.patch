+import { createHash, randomUUID } from "node:crypto";
+import { appendFileSync, mkdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { getAgentDir, logger } from "@oh-my-pi/pi-utils";
+import type { FetchImpl, RawSseEvent } from "../types";
+
+// Diagnostics never change a request, a response, retries, or method selection.
+// Only the final fetch body is an oracle; a Context is not a wire payload.
+type Json = null | boolean | number | string | Json[] | { [key: string]: Json };
+type Body = Record<string, Json>;
+type AuditOptions = { sessionId?: string; provider: string; sideRequest: boolean; refresh: boolean };
+
+function firstDifference(before: Json | undefined, after: Json | undefined, path: string): string | undefined {
+	if (before === after) return undefined;
+	if (typeof before === "string" && typeof after === "string" && /^system\[\d+\]\.text$/.test(path) &&
+		before.startsWith("x-anthropic-billing-header:") && after.startsWith("x-anthropic-billing-header:")) {
+		// Preserve cc_version changes; only the whole-body attestation necessarily moves each request.
+		if (before.replace(/\bcch=[a-f0-9]{5}\b/g, "cch=*") === after.replace(/\bcch=[a-f0-9]{5}\b/g, "cch=*")) return undefined;
+	}
+	if (Array.isArray(before) && Array.isArray(after)) {
+		for (let i = 0; i < Math.max(before.length, after.length); i++) {
+			const diff = firstDifference(before[i], after[i], `${path}[${i}]`);
+			if (diff) return diff;
+		}
+		return undefined;
+	}
+	if (before && after && typeof before === "object" && typeof after === "object" && !Array.isArray(before) && !Array.isArray(after)) {
+		const beforeKeys = Object.keys(before).filter(key => key !== "cache_control");
+		const afterKeys = Object.keys(after).filter(key => key !== "cache_control");
+		if (beforeKeys.join("\0") !== afterKeys.join("\0")) return `${path}.$keys`;
+		for (const key of new Set([...Object.keys(before), ...Object.keys(after)])) {
+			if (key === "cache_control") continue;
+			const diff = firstDifference(before[key], after[key], path ? `${path}.${key}` : key);
+			if (diff) return diff;
+		}
+		return undefined;
+	}
+	return path;
+}
+
+function breakpoints(body: Body): { path: string; control: Json }[] {
+	const result: { path: string; control: Json }[] = [];
+	const visit = (value: Json, path: string): void => {
+		if (Array.isArray(value)) {
+			for (let i = 0; i < value.length; i++) visit(value[i]!, `${path}[${i}]`);
+		} else if (value && typeof value === "object") {
+			for (const [key, entry] of Object.entries(value)) {
+				if (key === "cache_control") result.push({ path, control: entry });
+				else visit(entry, path ? `${path}.${key}` : key);
+			}
+		}
+	};
+	for (const key of ["tools", "system", "messages"]) if (body[key]) visit(body[key]!, key);
+	return result;
+}
+
+export function createAnthropicRequestAudit(options: AuditOptions) {
+	if (!options.sessionId || options.provider !== "anthropic" || process.env.OMP_PAYLOAD_ARCHIVE_OFF) return undefined;
+	const sessionId = options.sessionId;
+	const dir = join(getAgentDir(), "payloads", sessionId.replace(/[^a-zA-Z0-9._-]/g, "_"), "anthropic-wire");
+	let current: { stem: string; id: string } | undefined;
+	let warned = false;
+	const failed = (): void => {
+		if (warned) return;
+		warned = true;
+		try { logger.warn("Anthropic wire diagnostics unavailable", { sessionId }); } catch { /* Diagnostics must remain passive. */ }
+	};
+	return {
+		wrapFetch(base: FetchImpl): FetchImpl {
+			return async (input, init) => {
+				current = undefined;
+				try {
+					const rawBody = typeof init?.body === "string" ? init.body : init?.body instanceof Uint8Array ? new TextDecoder().decode(init.body) : undefined;
+					if (rawBody !== undefined) {
+						const body = JSON.parse(rawBody) as Body;
+						if (typeof body.model === "string" && Array.isArray(body.messages)) {
+							const url = new URL(typeof input === "string" ? input : input instanceof URL ? input.href : input.url);
+							const endpoint = `${url.origin}${url.pathname}`;
+							const edits = (body.context_management as { edits?: { type?: string; pause_after_compaction?: boolean }[] } | undefined)?.edits ?? [];
+							const compact = edits.some(edit => edit.type === "compact_20260112" && edit.pause_after_compaction === true);
+							const replay = !compact && body.messages.some(message => message && typeof message === "object" && !Array.isArray(message) && Array.isArray(message.content) && message.content.some(block => block && typeof block === "object" && !Array.isArray(block) && block.type === "compaction"));
+							const kind = compact ? "native-compaction" : replay ? "compaction-replay" : options.refresh ? "cache-refresh" : options.sideRequest ? "side" : "main";
+							const id = randomUUID();
+							const stem = join(dir, `${Date.now()}-${process.pid}-${id}-${kind}`);
+							const identity = createHash("sha256").update(JSON.stringify([sessionId, options.provider, endpoint, body.model])).digest("hex");
+							const baselineFile = join(dir, `${identity}.baseline.json`);
+							mkdirSync(dir, { recursive: true, mode: 0o700 });
+							writeFileSync(`${stem}.body.json`, rawBody, { mode: 0o600, flag: "wx" });
+							current = { stem, id };
+							const headers = new Headers(init.headers);
+							const allowedHeaders: Record<string, string> = {};
+							for (const name of ["anthropic-beta", "anthropic-version", "content-type"]) {
+								const value = headers.get(name);
+								if (value !== null) allowedHeaders[name] = value;
+							}
+							let comparison: Record<string, unknown> | undefined;
+							if (compact) {
+								comparison = { status: "no-baseline" };
+								try {
+									const pointer = JSON.parse(readFileSync(baselineFile, "utf8")) as { file: string; at: number };
+									const before = JSON.parse(readFileSync(pointer.file, "utf8")) as Body;
+									let difference = firstDifference(before.tools, body.tools, "tools") ?? firstDifference(before.system, body.system, "system");
+									const oldMessages = before.messages as Json[];
+									const messages = body.messages as Json[];
+									// Tail appends are allowed, deletion or modification of old history is not.
+									for (let i = 0; !difference && i < oldMessages.length; i++) difference = firstDifference(oldMessages[i], messages[i], `messages[${i}]`);
+									const controls = ["thinking", "output_config", "speed", "tool_choice", "metadata"].filter(key => firstDifference(before[key], body[key], key) !== undefined);
+									comparison = { status: difference ? "prefix-different" : "prefix-equal", firstDifference: difference, baseline: pointer.file, baselineAgeMs: Date.now() - pointer.at, beforeMessages: oldMessages.length, messages: messages.length, controlsChanged: controls, beforeBreakpoints: breakpoints(before), breakpoints: breakpoints(body) };
+								} catch (error) {
+									if ((error as NodeJS.ErrnoException).code !== "ENOENT") { comparison = { status: "comparison-unavailable" }; failed(); }
+								}
+							}
+							writeFileSync(`${stem}.meta.json`, JSON.stringify({ at: new Date().toISOString(), id, sessionId, provider: options.provider, model: body.model, endpoint, kind, headers: allowedHeaders, comparison }), { mode: 0o600, flag: "wx" });
+							if (!compact && !options.sideRequest && !options.refresh) {
+								const temporary = `${baselineFile}.${id}.tmp`;
+								writeFileSync(temporary, JSON.stringify({ file: `${stem}.body.json`, at: Date.now() }), { mode: 0o600, flag: "wx" });
+								renameSync(temporary, baselineFile);
+							}
+						}
+					}
+				} catch { failed(); }
+				try {
+					const response = await base(input, init);
+					if (current) {
+						try { appendFileSync(`${current.stem}.usage.jsonl`, `${JSON.stringify({ at: new Date().toISOString(), id: current.id, event: "response", status: response.status, requestId: response.headers.get("request-id") ?? response.headers.get("x-request-id") })}\n`, { mode: 0o600 }); } catch { failed(); }
+					}
+					return response;
+				} catch (error) {
+					if (current) {
+						try { appendFileSync(`${current.stem}.usage.jsonl`, `${JSON.stringify({ id: current.id, event: "transport-error", name: error instanceof Error ? error.name : "unknown" })}\n`, { mode: 0o600 }); } catch { failed(); }
+					}
+					throw error;
+				}
+			};
+		},
+		observe(event: RawSseEvent): void {
+			if (!current) return;
+			try {
+				const data = JSON.parse(event.data);
+				const usage = data.usage ?? data.message?.usage;
+				if (!usage && data.type !== "error" && data.type !== "message_stop") return;
+				appendFileSync(`${current.stem}.usage.jsonl`, `${JSON.stringify({ at: new Date().toISOString(), id: current.id, event: data.type ?? event.event, messageId: data.message?.id, usage, stopReason: data.delta?.stop_reason, errorType: data.error?.type })}\n`, { mode: 0o600 });
+			} catch { failed(); }
+		},
+	};
+}
