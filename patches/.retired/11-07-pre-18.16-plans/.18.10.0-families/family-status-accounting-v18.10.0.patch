+/** The latest settled assistant's cache usage, shared by both status surfaces. */
+function cacheTurnText(ctx: SegmentContext): string | undefined {
+	// Streaming usage is partial: input can arrive before cacheRead is backfilled.
+	const messages = ctx.session.messages ?? ctx.session.state.messages;
+	for (let index = messages.length - 1; index >= 0; index--) {
+		const message = messages[index];
+		if (
+			message?.role !== "assistant" ||
+			!message.stopReason ||
+			!message.usage ||
+			message.stopReason === "aborted" ||
+			message.stopReason === "error"
+		) {
+			continue;
+		}
+		const usage = message.usage;
+		if (!usage.cacheRead) return undefined;
+		const total = usage.cacheRead + usage.cacheWrite + usage.input;
+		const rate = total > 0 ? (usage.cacheRead / total) * 100 : 0;
+		return `trn ${formatNumber(usage.cacheRead)} ${rate.toFixed(1)}%`;
+	}
+	return undefined;
