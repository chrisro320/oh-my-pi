+/** The previous catalog's rows keyed to one rejected account, re-keyed to that account alone. */
+function retainedAccountCatalog(
+	previous: readonly Model<"google-gemini-cli">[],
+	accountKey: string,
+): ModelSpec<"google-gemini-cli">[] {
+	const retained: ModelSpec<"google-gemini-cli">[] = [];
+	for (const model of previous) {
+		const access = model.accountAccess;
+		if (!access || !Object.hasOwn(access, accountKey)) continue;
+		const own = access[accountKey];
+		if (own === undefined) continue;
+		retained.push({ ...toModelSpec(model), accountAccess: { [accountKey]: own } });
+	}
+	return retained;
+}
