+/**
+ * Fired after each prompt-cache warming refresh that reached the provider.
+ * `hit` means the replay read the cached prefix and wrote nothing; `miss` and
+ * `error` stop warming until the next real request.
+ */
+export interface CacheWarmingResultEvent {
+	type: "cache_warming_result";
+	outcome: "hit" | "miss" | "error";
+	/** Token usage of the replay; absent when the provider returned no response. */
+	usage?: { input: number; output: number; cacheRead: number; cacheWrite: number };
+	/** Why warming stopped after this refresh; absent while warming continues. */
+	stopReason?: string;
+}
