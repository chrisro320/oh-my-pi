+function idleWarmingAgeMs(): number {
+	const raw = process.env[IDLE_WARMING_AGE_ENV];
+	if (raw === undefined) return DEFAULT_IDLE_WARMING_AGE_MS;
+	const ms = Number(raw);
+	return Number.isSafeInteger(ms) && ms > 0 ? ms : DEFAULT_IDLE_WARMING_AGE_MS;
