+export interface ContextNotesUpdate extends ContextNotesRevision {
+	timestamp: string;
+	deliveryEntryId?: string;
 }
+
+/** Compaction freezes the head; subsequent changed revisions remain append-only. */
+export function getContextNotesProjection(entries: readonly SessionEntry[]): {
+	head?: ContextNotesUpdate;
+	updates: ContextNotesUpdate[];
+} {
+	let latest: ContextNotesUpdate | undefined;
+	let head: ContextNotesUpdate | undefined;
+	const updates: ContextNotesUpdate[] = [];
+	const pending = new Map<string, ContextNotesUpdate>();
+	for (const entry of entries) {
+		if (entry.type === "reset_boundary") {
+			latest = head = undefined;
+			updates.length = 0;
+			pending.clear();
+		} else if (entry.type === "compaction") {
+			head = latest?.text ? latest : undefined;
+			updates.length = 0;
+			pending.clear();
+		} else if (isContextNotesEntry(entry) && isContextNotesData(entry.data)) {
+			const changed = entry.data.text !== (latest?.text ?? "");
+			latest = { text: entry.data.text, entryId: entry.id, timestamp: entry.timestamp };
+			if (changed) {
+				updates.push(latest);
+				pending.set(entry.id, latest);
+			}
+		} else if (
+			entry.type === "custom_message" &&
+			entry.customType === CONTEXT_NOTES_ENTRY_TYPE &&
+			isRecord(entry.details) &&
+			typeof entry.details.contextNotesEntryId === "string"
+		) {
+			const update = pending.get(entry.details.contextNotesEntryId);
+			if (update) update.deliveryEntryId = entry.id;
+		}
+	}
+	return { head, updates };
+}
+
+export function createContextNotesMessage(revision: ContextNotesUpdate) {
+	const notes = revision.text || "[The notebook has been cleared. Earlier notebook revisions are no longer current.]";
+	return createCustomMessage(
+		CONTEXT_NOTES_ENTRY_TYPE,
+		prompt.render(contextNotesPrompt, { notes }).trim(),
+		false,
+		{ contextNotesEntryId: revision.entryId },
+		revision.timestamp,
+	);
+}
