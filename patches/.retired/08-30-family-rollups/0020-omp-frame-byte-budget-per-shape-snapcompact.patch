+/** Drop the oldest frames until the archive fits {@link FRAME_DATA_BYTES_BUDGET}
+ *  — the same oldest-first policy {@link MAX_FRAMES_DEFAULT} applies on frame
+ *  count. Returns the input untouched while it already fits, and when nothing
+ *  fits (a single frame over budget is not sheddable), so the caller's hard
+ *  payload check still fails it. */
+export function shedFramesOverBudget(frames: Frame[]): Frame[] {
+	if (frameDataBytes(frames) <= FRAME_DATA_BYTES_BUDGET) return frames;
+	const kept: Frame[] = [];
+	for (let index = frames.length - 1; index >= 0; index--) {
+		const candidate = [frames[index], ...kept];
+		if (frameDataBytes(candidate) > FRAME_DATA_BYTES_BUDGET) break;
+		kept.unshift(frames[index]);
+	}
+	return kept.length > 0 ? kept : frames;
