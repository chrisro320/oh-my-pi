+/** What the rejected-draft helpers need from the interactive mode. */
+export type RejectedDraftRuntime = {
+	editor: CustomEditor;
+	deferredDraftSnapshots: RestoredQueuedMessage[];
+	updatePendingMessagesDisplay(): void;
+	showWarning(message: string): void;
+	ui: { requestRender(): void };
+};
+
+/** A submission that left the editor and was then rejected before any turn started. */
+export type RejectedDraft = {
+	/** Text to show the operator again (the original, not a prepared replacement). */
+	text: string;
+	/** Model-side text when it differs, so the dequeue path can match the queued message. */
+	canonicalText?: string;
+	images?: ImageContent[];
+	imageLinks?: (string | undefined)[];
+};
+
+/**
+ * True when the editor's pending image still belongs to the captured draft: the
+ * same object, or the same bytes and mime as one of its captured images. The
+ * supported `input` handler path may hand back rebuilt objects for attachments it
+ * did not change, so identity alone would misread those as a newer draft.
+ */
+function isDraftOwnedImage(draft: RejectedDraft, image: ImageContent): boolean {
+	const owned = draft.images;
+	if (owned === undefined) return false;
+	if (owned.includes(image)) return true;
+	return owned.some(captured => captured.data === image.data && captured.mimeType === image.mimeType);
+}
+
+/**
+ * True when the editor holds something written since the draft was captured: a
+ * text revision change, text, or an attachment that is not one of the draft's
+ * own captured images (see {@link isDraftOwnedImage}). An ordinary Enter leaves
+ * the captured attachments in the editor until the submission is admitted, so a
+ * non-empty attachment list alone is not a newer draft; an image pasted while the
+ * submission was being prepared is one, because it is not one of the captured
+ * images. A re-paste of identical bytes reads as the draft's own; that residual
+ * is accepted.
+ */
+function editorHoldsNewerDraft(editor: CustomEditor, draft: RejectedDraft, revision: number | undefined): boolean {
+	if (revision !== undefined && editor.textRevision !== revision) return true;
+	if (editor.getText().length > 0) return true;
+	return editor.pendingImages.some(image => !isDraftOwnedImage(draft, image));
+}
+
+/** Keep a rejected capture restorable without touching the editor's newer draft. */
+export function retainRejectedDraft(runtime: RejectedDraftRuntime, draft: RejectedDraft): void {
+	runtime.deferredDraftSnapshots.push({
+		text: draft.text,
+		canonicalText: draft.canonicalText ?? draft.text,
+		images: draft.images ? [...draft.images] : undefined,
+	});
+	runtime.updatePendingMessagesDisplay();
+	runtime.showWarning("Input was not sent; it is listed below as restorable");
+}
+
+/**
+ * Hand a rejected submission back to the editor. It is written into the editor
+ * only while nothing newer lives there (the newer-draft guard below), and
+ * otherwise stays restorable through the dequeue path, so a newer draft or a
+ * freshly pasted attachment is never overwritten. A submission the session's own
+ * prompt-dropped callback already handed back must not reach this function: its
+ * caller skips that case by error class, not by comparing editor contents, which
+ * would swallow a distinct rejected submission that merely looks equal.
+ */
+export function restoreRejectedDraft(
+	runtime: RejectedDraftRuntime,
+	draft: RejectedDraft,
+	revision?: number,
+): void {
+	if (editorHoldsNewerDraft(runtime.editor, draft, revision)) {
+		retainRejectedDraft(runtime, draft);
+		return;
+	}
+	if (draft.images && draft.images.length > 0) {
+		runtime.editor.pendingImages = [...draft.images];
+		runtime.editor.pendingImageLinks = draft.imageLinks ? [...draft.imageLinks] : draft.images.map(() => undefined);
+		runtime.editor.imageLinks = runtime.editor.pendingImageLinks;
+	}
+	runtime.editor.setCollapsedText(draft.text);
+	runtime.ui.requestRender();
+}
