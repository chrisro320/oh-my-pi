+	#[test]
+	fn chrome_profile_titles_preserve_unique_window_ownership() {
+		let mut window = DesktopWindow {
+			id:      "1".into(),
+			pid:     Some(10),
+			title:   "Settings - Google Chrome".into(),
+			app:     "Google-chrome".into(),
+			x:       0,
+			y:       0,
+			width:   100,
+			height:  100,
+			focused: false,
+		};
+		let title = "Settings - Google Chrome \u{2013} work";
+		assert_eq!(native_window_for_frame(&[window.clone()], 10, title).unwrap(), "1");
+		assert!(native_window_for_frame(&[window.clone()], 20, title).is_err());
+		assert!(native_window_for_frame(&[window.clone(), window.clone()], 10, title).is_err());
+		let mut exact = window.clone();
+		exact.id = "2".into();
+		exact.title = title.into();
+		assert!(native_window_for_frame(&[window.clone(), exact], 10, title).is_err());
+		for mismatch in [
+			"Settings - Google Chrome \u{2013} ",
+			"Settings - Google Chrome - work",
+			"Settings - Google Chrome extra \u{2013} work",
+		] {
+			assert!(native_window_for_frame(&[window.clone()], 10, mismatch).is_err());
+		}
+		window.app = "Editor".into();
+		assert!(native_window_for_frame(&[window.clone()], 10, title).is_err());
+		assert_eq!(
+			native_window_for_frame(&[window.clone()], 10, &window.title).unwrap(),
+			"1"
+		);
+		window.app = "Google-chrome".into();
+		window.title = "Save As".into();
+		assert!(native_window_for_frame(&[window.clone()], 10, "Save As \u{2013} work").is_err());
+		window.title.clear();
+		assert!(native_window_for_frame(&[window], 10, " \u{2013} work").is_err());
+	}
