+fn frame_title_matches(window: &DesktopWindow, title: &str) -> bool {
+	window.title == title
+		// Chrome decorates its AX browser-frame name with the profile name.
+		|| (window.app.eq_ignore_ascii_case("google-chrome")
+			&& window.title.ends_with(" - Google Chrome")
+			&& title
+				.strip_prefix(window.title.as_str())
+				.and_then(|suffix| suffix.strip_prefix(" \u{2013} "))
+				.is_some_and(|profile| !profile.is_empty()))
+}
